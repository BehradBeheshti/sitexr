{
  "name": "sitexr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SiteXR \u2014 Immersive Construction Review (Meta Quest 3 WebXR)",
  "scripts": {
    "dev": "vite --host",
    "dev:https": "vite --host --config vite.https.config.js",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "npm run build && node tools/smoke-test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "assets": "bash tools/build-scene.sh",
    "controllers": "node tools/sync-controller-profiles.mjs",
    "test:vr": "node tools/xr-test.mjs",
    "test:all": "npm run build && node tools/smoke-test.mjs && node tools/xr-test.mjs excavator && node tools/xr-test.mjs komatsu && node tools/xr-test.mjs scaffold"
  },
  "dependencies": {
    "playcanvas": "^2.22.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@playcanvas/splat-transform": "^3.4.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@webxr-input-profiles/assets": "^1.0.20",
    "iwer": "^2.4.0",
    "puppeteer-core": "^25.11.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
